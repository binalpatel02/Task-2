{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "ignoreDeprecations": "5.0",
    
    // Blocks the root compiler from ever leaking raw .js files into your folders
    "noEmit": true
  },
  "include": [
    "app/**/*.ts",
    "library/**/*.ts"
  ],
  "exclude": ["**/node_modules", "**/dist"]
}
